{
  "name": "crm-estrategico-es-em-acao",
  "version": "0.1.0",
  "private": true,
  "description": "CRM Estratégico — ES em Ação: gestão estratégica de relacionamentos institucionais.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar": "npm run typecheck && npm run lint && npm run test && npm run test:regras && npm run build",
    "banco:gerar": "drizzle-kit generate",
    "banco:exemplos": "tsx scripts/carregar-exemplos.ts",
    "banco:reiniciar": "tsx scripts/reiniciar-banco.ts",
    "ambiente:conferir": "tsx scripts/conferir-ambiente.ts",
    "ambiente:senha-admin": "tsx scripts/senha-administrativa.ts",
    "supabase:marcar-descartavel": "tsx scripts/marcar-banco-descartavel.ts",
    "supabase:preparar": "tsx scripts/supabase-preparar.ts",
    "test:regras": "vitest run --config vitest.regras.config.mts",
    "test:postgres": "vitest run --config vitest.postgres.config.mts",
    "test:supabase": "vitest run --config vitest.supabase.config.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "server-only": "0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
