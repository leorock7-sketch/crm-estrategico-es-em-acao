# =====================================================================
# Modelo de variáveis de ambiente — NÃO coloque valores reais aqui.
#
# Este arquivo é versionado e serve apenas para listar os NOMES das
# configurações. Para usar, copie-o para ".env.local" (arquivo que o
# Git ignora) e preencha os valores nessa cópia.
# =====================================================================

# Banco local de desenvolvimento (PGlite). Em modo de produção (npm start),
# ele só é aceito com esta autorização, destinada a testes locais da versão
# compilada. Nunca use em hospedagem real.
# CRM_BANCO=pglite

# Projeto Supabase exclusivo de desenvolvimento (Etapa 5, D-074; somente dados
# fictícios). Preencha SOMENTE em ".env.local", nunca aqui nem em conversas.
# Endereço do projeto e chave pública (publishable): vão para o navegador.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só para criar e desativar contas, no servidor. Ignora as regras
# de acesso: nunca use o prefixo NEXT_PUBLIC_ nem a envie ao navegador.
# SUPABASE_SECRET_KEY=
# Conexão usada pela aplicação: papel crm_app, sem privilégios (as regras valem).
# Fica em branco até a criação do papel, que preenche o valor em ".env.local".
# CRM_BANCO_URL=
# Conexão administrativa: só para os comandos de migração, nunca para a aplicação.
# CRM_BANCO_ADMIN_URL=

# Para conferir o ambiente sem exibir nenhum valor: npm run ambiente:conferir
