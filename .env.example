# =====================================================================
# Modelo de variáveis de ambiente — NÃO coloque valores reais aqui.
#
# Este arquivo é versionado e serve apenas para listar os NOMES das
# configurações. Para usar, copie-o para ".env.local" (arquivo que o
# Git ignora) e preencha os valores nessa cópia.
# =====================================================================

# Banco local de desenvolvimento (PGlite). Em modo de produção (npm start),
# ele só é aceito com esta autorização, destinada a testes locais da versão
# compilada. Nunca use em hospedagem real.
# CRM_BANCO=pglite

# Projeto Supabase exclusivo de desenvolvimento (Etapa 5, D-074; somente dados
# fictícios). Preencha SOMENTE em ".env.local", nunca aqui nem em conversas.
# Endereço do projeto e chave pública (publishable): vão para o navegador.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só para criar e desativar contas, no servidor. Ignora as regras
# de acesso: nunca use o prefixo NEXT_PUBLIC_ nem a envie ao navegador.
# SUPABASE_SECRET_KEY=
# Conexão usada pela aplicação: papel crm_app, sem privilégios (as regras valem).
# Fica em branco até "npm run supabase:preparar", que preenche o valor em ".env.local".
# CRM_BANCO_URL=
# Conexão administrativa: só para os comandos de migração, nunca para a aplicação.
# CRM_BANCO_ADMIN_URL=

# Único projeto em que comandos destrutivos podem rodar neste computador. Preenchido por
# "npm run supabase:marcar-descartavel". Banco marcado não pode receber dados institucionais reais (D-077).
# CRM_BANCO_DESCARTAVEL_REF=

# Monitoramento (D-082): conexão do papel crm_monitor, sem acesso a tabelas. Preenchida por
# "npm run monitor:preparar" somente no projeto de desenvolvimento.
# CRM_MONITOR_URL=

# Cópias de segurança (D-082), somente de dados fictícios enquanto não houver definição institucional.
# Pasta dos programas do PostgreSQL 17 (pg_dump, pg_restore, initdb, pg_ctl) e do age:
# CRM_PG_BIN=
# CRM_AGE_BIN=
# Chave PÚBLICA do age (destinatário); a chave privada fica fora do repositório e dos backups:
# CRM_BACKUP_DESTINATARIO_AGE=
# Arquivo da chave privada, só para o ensaio de restauração (fora do repositório e do Drive):
# CRM_BACKUP_IDENTIDADE_AGE=
# Destinos: pasta local e pasta no Google Drive:
# CRM_BACKUP_PASTA_LOCAL=
# CRM_BACKUP_PASTA_NUVEM=

# Para conferir o ambiente sem exibir nenhum valor: npm run ambiente:conferir
