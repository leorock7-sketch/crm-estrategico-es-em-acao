# =====================================================================
# Arquivos e pastas que o Git deve ignorar (nunca enviados ao GitHub).
# Padrões iniciados por "/" valem apenas na raiz do projeto, para não
# esconder, por engano, pastas de código que tenham o mesmo nome.
# =====================================================================

# --- Dependências (baixadas por "npm install"; nunca versionar) ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
.npm/

# --- Resultados de compilação ---
/.next/
/out/
/build/
/dist/
next-env.d.ts
*.tsbuildinfo

# --- Resultados de testes ---
/coverage/
*.lcov
/.nyc_output/
/test-results/
/playwright-report/
/blob-report/

# --- Variáveis de ambiente e segredos (senhas, tokens, chaves) ---
# O arquivo .env.example (somente nomes, sem valores) é versionado.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- Hospedagem e serviços (configurações locais) ---
.vercel
/supabase/.temp/
/supabase/.branches/

# --- Registros (logs) e relatórios de diagnóstico ---
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Caches de ferramentas ---
.eslintcache
.stylelintcache
/.cache/
/.turbo/
/.temp/

# --- Claude Code: pastas de trabalho temporárias e configurações pessoais ---
# O arquivo .claude/settings.json, se existir, é compartilhado e versionado.
.claude/worktrees/
.claude/settings.local.json

# --- Sistema operacional, editores e Google Drive ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.tmp.drivedownload/
.tmp.driveupload/
